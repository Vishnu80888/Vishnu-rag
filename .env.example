# LLM Provider: "local" (EchoLLM for offline tests) or "openai_compatible" (LM Studio, vLLM, Ollama, OpenAI)
LLM_PROVIDER=openai_compatible

# Embedding Provider:
# - "fastembed" (Recommended offline neural embeddings: pure-Python ONNX, BAAI/bge-small-en-v1.5, dim 384, no server needed)
# - "openai_compatible" (Remote OpenAI-compatible embedding endpoint)
# - "local" (Fast deterministic hash embeddings for unit testing)
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Vector Store: "memory" (RAM) or "qdrant" (Persistent local disk or remote server)
VECTOR_STORE_PROVIDER=memory
QDRANT_PATH=./data/qdrant_local   # Embedded local Qdrant (pure-Python, no Docker needed)
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION_NAME=profi_rag

# OpenAI-Compatible Server (used when LLM_PROVIDER or EMBEDDING_PROVIDER is openai_compatible)
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
LLM_MODEL=qwen
EMBEDDING_MODEL=text-embedding-bge-m3@q8_0
EMBEDDING_DIMENSION=1024

# Knowledge Base & Retrieval Pipeline Settings
DOCS_DIR=data/docs
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
MAX_CANDIDATES=20

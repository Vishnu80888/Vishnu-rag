# Providers: "local" (offline hash embeddings / echo LLM) or "openai_compatible" (LM Studio, vLLM, OpenAI...)
LLM_PROVIDER=local
EMBEDDING_PROVIDER=local
VECTOR_STORE_PROVIDER=memory      # memory | qdrant
OPENAI_BASE_URL=http://192.168.88.10:1234/v1
OPENAI_API_KEY=your_api_key_or_lm_studio
LLM_MODEL=qwen3.6-14b-a3b-fablevibes@q5_k_m
# For EMBEDDING_PROVIDER=openai_compatible, use text-embedding-bge-m3@q8_0 (dim 1024) or text-embedding-nomic-embed-text-v1.5 (dim 768)
EMBEDDING_MODEL=text-embedding-bge-m3@q8_0
EMBEDDING_DIMENSION=1024
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant_local   # embedded Qdrant, no Docker needed (leave QDRANT_URL empty)
COLLECTION_NAME=vishnu_rag
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
MAX_CANDIDATES=20

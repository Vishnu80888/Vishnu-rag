# Providers: "local" (offline hash embeddings / echo LLM) or "openai_compatible" (LM Studio, vLLM, OpenAI...)
LLM_PROVIDER=local
EMBEDDING_PROVIDER=local
VECTOR_STORE_PROVIDER=memory      # memory | qdrant
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
LLM_MODEL=qwen
EMBEDDING_MODEL=text-embedding-model
EMBEDDING_DIMENSION=256
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant_local   # embedded Qdrant, no Docker needed (leave QDRANT_URL empty)
COLLECTION_NAME=vishnu_rag
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
MAX_CANDIDATES=20
